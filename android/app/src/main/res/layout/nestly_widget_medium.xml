<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/nestly_widget_bg_mint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_nest_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/nestly_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="The Casaio Family" />

        <TextView
            android:id="@+id/widget_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nestly_ink_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Today" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/nestly_ink_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Open Casaio to join a nest"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_row_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/nestly_dot_lavender" />

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/widget_tasks"
                android:textColor="@color/nestly_ink_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tasks_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/nestly_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="3 open" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/nestly_dot_teal" />

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/widget_next"
                android:textColor="@color/nestly_ink_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_event_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/nestly_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Soccer · Tue · 4:00 PM" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_dinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/nestly_dot_mint" />

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/widget_dinner"
                android:textColor="@color/nestly_ink_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_dinner_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/nestly_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Pasta night" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/nestly_ink_muted"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="Updated 2m ago" />
</LinearLayout>
